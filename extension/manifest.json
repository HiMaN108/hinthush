{
  "manifest_version": 3,
  "name": "HintHush",
  "version": "1.0.0",
  "description": "Hides \"Click & hold to reveal\" labels on any site, and reveals blurred content on your own local test pages.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "HintHush",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "settings.js",
        "labelhide.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://*.localhost/*",
        "http://*.test/*",
        "https://localhost/*",
        "https://127.0.0.1/*",
        "https://*.localhost/*",
        "https://*.test/*"
      ],
      "js": [
        "settings.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html"
}